  "idempotency_requirements": [
    {
      "family": "availability_save",
      "logical_identity": "employee_id + target_week + work_date + interval identity",
      "duplicate_retry": "same logical mutation must converge without duplicate active interval",
      "actor": "EMPLOYEE"
    },
    {
      "family": "schedule_publish",
      "logical_identity": "schedule/version + official assignment logical identity",
      "duplicate_retry": "retry/double-click/reload must not create duplicate assignments or competing published version",
      "actor": "MANAGER"
    },
    {
      "family": "swap_accept_approve_apply",
      "logical_identity": "swap_request_id + transition",
      "duplicate_retry": "accepted/approved/applied transition must be exactly-once logically; repeated apply cannot exchange twice",
      "actor": "PEER_EMPLOYEE/MANAGER/SYSTEM"
    },
    {
      "family": "give_accept_approve_apply",
      "logical_identity": "give_request_id + transition",
      "duplicate_retry": "repeated accept/approve/apply converges; assignment transfers at most once",
      "actor": "RECIPIENT_EMPLOYEE/MANAGER/SYSTEM"
    },
    {
      "family": "attendance_submit",
      "logical_identity": "assignment_id + employee_id + active submission revision",
      "duplicate_retry": "retry/double-submit/reload must not create duplicate active submission for the same logical revision",
      "actor": "EMPLOYEE"
    },
    {
      "family": "attendance_review",
      "logical_identity": "attendance_submission_id + review revision",
      "duplicate_retry": "repeated review command cannot produce competing confirmed work time revisions",
      "actor": "MANAGER"
    },
    {
      "family": "payroll_finalize",
      "logical_identity": "payroll_period + employee_id + payroll_revision",
      "duplicate_retry": "finalize retry cannot create a second final truth for the same revision",
      "actor": "PAYROLL_AUTHORIZED"
    }
  ],
